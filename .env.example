# Copy to .env and fill in. Never commit .env (it is in .gitignore).
# Create every key with the channel's NEW email/accounts, not personal ones. See SETUP.md.
GROQ_API_KEY=             # https://console.groq.com/keys -- free; writes the scripts when llm.provider = openai (the default)
ANTHROPIC_API_KEY=        # https://console.anthropic.com -- only if llm.provider = anthropic (Claude, with web research)
PEXELS_API_KEY=           # https://www.pexels.com/api/ -- free stock footage/photos (optional but recommended)
ELEVENLABS_API_KEY=       # https://elevenlabs.io -- only if voice.provider = elevenlabs
FYT_CONTACT=              # your channel's contact email or GitHub repo URL; Wikipedia asks bots to identify themselves
